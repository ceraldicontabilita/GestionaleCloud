# GestionaleCloud - Template variabili Render
# Copia/incolla queste chiavi nella dashboard Render (Environment).
# NON committare valori reali/segreti.

# -------------------------------------------------------------------
# BLOCCO BASE (obbligatorio)
# -------------------------------------------------------------------
ENVIRONMENT=production
PYTHON_VERSION=3.12.10
PYTHONUTF8=1
FAIL_FAST_SECRETS=true

SECRET_KEY=__GENERA_UNA_CHIAVE_LUNGA_E_RANDOM__
DB_NAME=Gestionale

LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS same-origin consigliato (impostasolo se ti serve cross-site):
# CORS_ALLOWED_ORIGINS=https://impresasemplice.online
ALLOW_CREDENTIALS=true

# -------------------------------------------------------------------
# ARCHIVIO OPERATIVO DRIVE/SHEETS
# Il registro deve essere indicato esplicitamente: nessun fallback MongoDB.
# -------------------------------------------------------------------
DATA_BACKEND=sheets
GOOGLE_SHEETS_LEDGER_ID=__SHEETS_LEDGER_ID_OPPURE_LASCIA_VUOTO__
GOOGLE_SHEETS_LEDGER_FOLDER_ID=__SHEETS_LEDGER_FOLDER_ID__
GOOGLE_DRIVE_SA_JSON={"type":"service_account",...}

# -------------------------------------------------------------------
# COMPATIBILITA TRANSITORIA ESPLICITA
# Solo per verifiche/migrazioni controllate, mai come fallback di Sheets.
# -------------------------------------------------------------------
# DATA_BACKEND=mongodb
# MONGODB_ATLAS_URI=__MONGO_URI_SOLO_COMPATIBILITA__

# Cartelle Drive principali (imposta quelle realmente usate):
# GOOGLE_DRIVE_FATTURE_FOLDER_ID=__ID__
# GOOGLE_DRIVE_CEDOLINI_FOLDER_ID=__ID__
# GOOGLE_DRIVE_CORRISPETTIVI_FOLDER_ID=__ID__
# GOOGLE_DRIVE_QUIETANZE_FOLDER_ID=__ID__
# GOOGLE_DRIVE_ESTRATTI_FOLDER_ID=__ID__
# GOOGLE_DRIVE_BONIFICI_FOLDER_ID=__ID__

# -------------------------------------------------------------------
# SCHEDULER E FLUSSI
# -------------------------------------------------------------------
ENABLE_SCHEDULER=true
SCHEDULER_LEASE_SECONDS=21600

# Drive channels (default coerenti con config):
ENABLE_DRIVE_FATTURE_SYNC=true
ENABLE_DRIVE_CEDOLINI_SYNC=true
ENABLE_DRIVE_CORRISPETTIVI_SYNC=true
ENABLE_DRIVE_QUIETANZE_SYNC=true
ENABLE_DRIVE_ESTRATTI_CONTO_SYNC=true
ENABLE_DRIVE_BONIFICI_SYNC=false
ENABLE_DRIVE_DICHIARAZIONI_IVA_SYNC=false
ENABLE_DRIVE_CARTELLE_ESATTORIALI_SYNC=false
ENABLE_DRIVE_AVVISI_BONARI_SYNC=false
ENABLE_DRIVE_VERBALI_SYNC=false
DRIVE_FATTURE_BATCH_SIZE=1
DRIVE_ESTRATTI_BATCH_SIZE=1
DRIVE_ESTRATTI_ANNO_MINIMO=2026

# -------------------------------------------------------------------
# TELEGRAM (canale notifiche attivo)
# -------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=__TELEGRAM_BOT_TOKEN__
TELEGRAM_CHAT_ID=__TELEGRAM_CHAT_ID__

# -------------------------------------------------------------------
# INTEGRAZIONI OPZIONALI
# -------------------------------------------------------------------
# SMTP
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=__USER__
# SMTP_PASSWORD=__PASSWORD__
# SMTP_FROM_EMAIL=__MAIL_MITTENTE__

# Gmail IMAP
# GMAIL_IMAP_ENABLED=false
# GMAIL_EMAIL=__MAIL__
# GMAIL_APP_PASSWORD=__APP_PASSWORD__

# OAuth Google login
# GOOGLE_CLIENT_ID=__CLIENT_ID__
# GOOGLE_CLIENT_SECRET=__CLIENT_SECRET__
# GOOGLE_REDIRECT_URI=/api/auth/google/callback

# AI
# OPENAI_API_KEY=__OPENAI_KEY__
# GEMINI_API_KEY=__GEMINI_KEY__

# Gateway esterni
# PAYPAL_CLIENT_ID=__PAYPAL_CLIENT_ID__
# PAYPAL_CLIENT_SECRET=__PAYPAL_CLIENT_SECRET__
# SUMUP_API_KEY=__SUMUP_KEY__
# SUMUP_MERCHANT_CODE=__SUMUP_MERCHANT_CODE__
# OPENAPI_IT_KEY=__OPENAPI_IT_KEY__
# OPENAPI_IMPRESE_TOKEN=__OPENAPI_IMPRESE_TOKEN__

# -------------------------------------------------------------------
# CHECK RAPIDO POST-DEPLOY
# -------------------------------------------------------------------
# 1) /api/health deve rispondere 200
# 2) log di connessione al registro Sheets senza ripiego su MongoDB
# 3) ricostruzione verificabile da Drive/Sheets e originali Drive
