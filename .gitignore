# Ceraldi ERP .gitignore

# IDE
.idea/
.vscode/

# Dependencies
node_modules/
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins

# Testing
/coverage
.pytest_cache/
frontend/.pytest_cache/
tmp/

# Production builds
/build
dist/
frontend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.codex-*.log
.codex-*.err.log
.codex-pytest*/
.codex-test-temp*/
.verify-pytest*/
.testtmp-cache*/

# System files
.DS_Store
*.pem

# Python
__pycache__/
*.pyc
venv/
.venv/

# Archive files
**/*.zip
**/*.tar.gz
*.pack

# Build caches
.cache/
frontend/node_modules/.cache/

# Environment and credential files — non devono MAI finire nel repo
.env
.env.*
*.env
*token.json*
credentials.json
*credentials.json*
*.key
.credentials

# Documenti caricati a runtime — l'app scrive in /tmp/uploads/ (effimero,
# container storage), mai in questa cartella. Non deve mai finire committata:
# ha contenuto dati reali (fatture, verbali, ricevute).
uploads/
.private/

# npm lockfile generated by the web session-start hook (yarn.lock is source of truth)
frontend/package-lock.json

# Il frontend viene compilato durante ogni deploy Render; gli artefatti Vite
# non appartengono al repository.

# Dati reali importati: MAI nel repository
app/uploads/
app/static/tracciabilita/uploads/

# Lotti (frontend_lotti/): il file .env.production contiene solo PUBLIC_URL e
# percorsi relativi (nessun segreto) e public/uploads/ sono foto prodotto statiche
# committate nel repo Lotti — devono restare tracciate. build/ e node_modules/
# sono già esclusi da frontend_lotti/.gitignore.
!frontend_lotti/.env.production
!frontend_lotti/public/uploads/

# Menu originale (frontend_menu/): stesso criterio di frontend_lotti — .env.production
# contiene solo PUBLIC_URL e percorsi relativi (nessun segreto) e deve restare tracciato;
# build/ e node_modules/ sono gia' esclusi da frontend_menu/.gitignore.
!frontend_menu/.env.production
